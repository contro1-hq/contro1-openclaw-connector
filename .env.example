# Contro1 / CENTCOM
CONTRO1_API_KEY=cc_live_your_key
CONTRO1_BASE_URL=https://api.contro1.com/api/centcom/v1
CONTRO1_WEBHOOK_SECRET=whsec_your_secret
PUBLIC_BASE_URL=https://your-openclaw-bridge.example.com

# Bridge server
LISTENER_PORT=8092
CALLBACK_MAX_SKEW_SECONDS=300

# Grant allow-once (default) or allow-always in OpenClaw when a reviewer approves.
# allow-always writes a durable OpenClaw allowlist entry, so leave this off unless
# you deliberately want future identical commands to skip the human.
CONTRO1_GRANT_ALLOW_ALWAYS=false

# How the bridge reaches OpenClaw: cli (default, uses the documented
# `openclaw approvals` commands), mock (no OpenClaw needed), or gateway (preview).
OPENCLAW_TRANSPORT=cli
OPENCLAW_BINARY=openclaw
OPENCLAW_GATEWAY_URL=wss://your-gateway.example.com
OPENCLAW_GATEWAY_TOKEN=your-operator-approvals-token
OPENCLAW_POLL_INTERVAL_MS=3000

# Policy. Point CONTRO1_POLICY_FILE at a JSON file to override the built-in
# defaults (see docs/openclaw-connector.md for the schema). Leave unset to use
# the conservative defaults: nothing is auto-allowed and destructive shapes are
# blocked before they reach a reviewer.
CONTRO1_POLICY_FILE=
